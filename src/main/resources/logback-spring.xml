<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_PATH" value="${user.home}/voculares/logs"/>
    <!-- Definir el appender que guarda los logs en archivo -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- Archivo de log donde se guardarán los mensajes -->
        <!--<file>${user.home}/onboarding/onboarding-log/</file>-->
        <file>${LOG_PATH}/onboarding.log</file>

        <!-- Definir cómo rotar el archivo de log -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Nombre del archivo de log rotado con fecha -->
            <!--<fileNamePattern>logs/log-onboarding-%d{yyyy-MM-dd}.log</fileNamePattern>-->
            <fileNamePattern>${LOG_PATH}/log-onboarding-%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Mantener logs rotados por 30 días -->
            <maxHistory>30</maxHistory>
            <!-- Comprimir logs rotados -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <!-- Formato del log -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Definir el appender de consola (opcional) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Definir el logger raíz (ROOT logger) -->
    <root level="info">
        <appender-ref ref="FILE" />
        <appender-ref ref="STDOUT" />
    </root>

</configuration>